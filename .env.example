# Variables de entorno para el módulo de descarga de audios desde YouTube

# URL del backend API
REACT_APP_API_URL=http://localhost:3100

# API Key para autenticación con el backend (ZAM_API_KEY)
# DEBE SER LA MISMA QUE LA CONFIGURADA EN EL BACKEND
# NOTA: esta clave ya NO es la contraseña del módulo "Audios YouTube". Ahora el
# modal de acceso envía la clave al backend (AUDIO_ACCESS_PASSWORD) y recibe una
# sesión firmada de 24 horas. Esta variable sigue siendo necesaria para las
# llamadas a la API (listar, descargar, procesar).
REACT_APP_API_KEY=tu-zam-api-key-aqui-misma-que-el-backend
